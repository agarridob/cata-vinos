# ── Datos de cata en vivo: NO versionar ──────────────────
# Ignora todo data/ y luego se readmite solo la plantilla
data/*
!data/wines.example.json
!data/wines.pruebas.json

# ── Backups locales de plantillas ─────
templates/*.bak-*
templates/*.v[0-9]*

# ── Certificados / secretos (por si acaso) ───────────────
*.pem
*.key
*.crt
.env
!.env.example
.venv/

# ── Sistema / Python ────────────
.DS_Store
__pycache__/
*.pyc
*.pyo

# ── systemd local real ─────────────────────────────────
cata-vinos.service
*.service.local

.cache/
journey_europe_entry.json

# ── Config local de Claude Code (rutas específicas de máquina) ──
.claude/
