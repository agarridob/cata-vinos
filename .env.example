SECRET_KEY=pon_aqui_una_secret_key_generada
ADMIN_PASSWORD=pon_aqui_la_password_de_admin

# ── Cloudflare Access (opcional) ──────────────────────────────────────────────
# Login por internet delante del panel de control. Si se dejan vacías, solo
# funciona la contraseña de arriba (acceso local por LAN).
#   CF_ACCESS_TEAM_DOMAIN → dominio del equipo Zero Trust (miequipo.cloudflareaccess.com)
#   CF_ACCESS_AUD         → Application Audience (AUD) tag de la app en Access
#   CF_ACCESS_EMAILS      → allowlist opcional de correos, separados por comas
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_EMAILS=
